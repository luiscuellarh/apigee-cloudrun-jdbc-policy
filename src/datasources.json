{
  "datasources": [
    {
      "datasource_id": "enterprise-sqlite",
      "description": "Built-in self-contained SQLite database pre-seeded with subscribers, orders, and audit_log tables",
      "driver": "sqlite",
      "jdbc_url": "jdbc:sqlite::memory:",
      "min_pool_size": 3,
      "max_pool_size": 10,
      "max_idle_time_sec": 300,
      "keep_alive_sec": 30,
      "query_timeout_ms": 5000
    }
  ]
}
